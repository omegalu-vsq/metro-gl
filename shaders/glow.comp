#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D scene_texture;
layout(binding = 1) uniform sampler2D glow_texture;
layout(rgba16f, binding = 0) writeonly uniform image2D output_image;

const float weights[] = float[](0.20, 0.18, 0.12, 0.07, 0.03);
const float glow_strength = 2.0;

vec3 sRGBToLinear(vec3 value) {
    return mix(pow((value + 0.055) / 1.055, vec3(2.4)), value / 12.92, lessThanEqual(value, vec3(0.04045)));
}

vec3 LinearTosRGB(vec3 value) {
    return mix(1.055 * pow(value, vec3(1.0 / 2.4)) - 0.055, value * 12.92, lessThanEqual(value, vec3(0.0031308)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(output_image);

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 step_uv = vec2(2.0) / vec2(size);
    vec3 glow = vec3(0.0);

    for (int y = -4; y <= 4; y++)
        for (int x = -4; x <= 4; x++)
            glow += texture(glow_texture, uv + vec2(x, y) * step_uv).rgb * weights[abs(x)] * weights[abs(y)];

    vec3 color = sRGBToLinear(texture(scene_texture, uv).rgb) + glow * glow_strength;
    imageStore(output_image, pixel, vec4(LinearTosRGB(color), 1.0));
}
