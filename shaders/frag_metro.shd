#version 450

#define LIGHTS 20

uniform vec3 color;
uniform float alpha;

layout(location=0) out vec4 output_color;

uniform int nb_light;
uniform vec3 lights[LIGHTS];
uniform vec3 metro_lights[2];
uniform float metro_light_power;

in vec3 position_view;
in vec3 position_world;
in vec3 normal_frag;

uniform vec3 light_color;

uniform mat4 model_view_matrix;

void main() {
    vec3 normal = normalize(normal_frag);

    vec3 lightning = vec3(0.12);
    vec3 specular = vec3(0.0);
    vec3 emission = vec3(0.0);

    for (int i = 0; i < nb_light; i++) {
        vec3 light_view = (model_view_matrix * vec4(lights[i], 1.0)).xyz;
        vec3 dirlight = normalize(light_view - position_view);
        float diffuse = clamp(dot(normal, dirlight), 0.0, 1.0);
        vec3 view_dir = normalize(-position_view);
        vec3 half_dir = normalize(dirlight + view_dir);
        float spec = pow(clamp(dot(normal, half_dir), 0.0, 1.0), 64.0);

        float dist = length(light_view - position_view);
        float attenuation = 1.0 / (1.0 + 0.04 * dist + 0.01 * dist * dist);

        lightning += diffuse * attenuation * light_color;
        specular += spec * attenuation * vec3(0.5);
    }

    for (int i = 0; i < 2; i++) {
        float light_power = 0.0;
        float fade_start = metro_lights[i].z;
        float fade_end = metro_lights[i].z + 1.2;

        if (position_world.z > fade_end)
            light_power = metro_light_power;
        else if (position_world.z > fade_start) {
            float fade = (position_world.z - fade_start) / (fade_end - fade_start);
            light_power = mix(0.0, metro_light_power, fade);
        }

        vec3 light_view = (model_view_matrix * vec4(metro_lights[i], 1.0)).xyz;
        vec3 dirlight = normalize(light_view - position_view);
        float diffuse = clamp(dot(normal, dirlight), 0.0, 1.0);
        vec3 view_dir = normalize(-position_view);
        vec3 half_dir = normalize(dirlight + view_dir);
        float spec = pow(clamp(dot(normal, half_dir), 0.0, 1.0), 64.0);

        float dist = length(light_view - position_view);
        float attenuation = light_power / (1.0 + 0.2 * dist + 0.08 * dist * dist);

        lightning += diffuse * attenuation * vec3(1.0, 0.92, 0.75);
        specular += 0.65 * spec * attenuation * vec3(1.0, 0.92, 0.75);

        vec3 spot_delta = position_world - metro_lights[i];
        float front_face = 1.0 - clamp(abs(spot_delta.z) / 1.2, 0.0, 1.0);
        float spot_dist = length(vec2(spot_delta.x / 0.1, spot_delta.y / 0.1));
        float core = spot_dist < 0.6 ? front_face : 0.0;
        float halo = (1.0 - clamp((spot_dist - 0.6) / 1.5, 0.0, 1.0)) * front_face;

        emission += 8.0 * core * vec3(1.0, 0.98, 0.88);
        emission += 1.2 * halo * vec3(1.0, 0.78, 0.35);
    }

    output_color = vec4(min(color * lightning + specular + emission, vec3(1.0)), alpha);
}
