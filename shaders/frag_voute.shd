#version 450

#define LIGHTS 20

uniform vec3 color;

layout(location=0) out vec4 output_color;

struct TubeLight {
    vec3 color;
    float intensity;
    float radius;
    vec3 points[2];
};
uniform TubeLight tubelights[LIGHTS];

uniform sampler2D LTC1; // for inverse M
uniform sampler2D LTC2; // GGX norm, fresnel, 0(unused), sphere

const float LUT_SIZE  = 64.0; // ltc_texture size
const float LUT_SCALE = (LUT_SIZE - 1.0)/LUT_SIZE;
const float LUT_BIAS = 0.5/LUT_SIZE;
const float PI = 3.14159265;

mat3 Minv = mat3(1.0);
mat3 width_matrix = mat3(1.0);

uniform int nb_tubelights;
uniform vec3 metro_lights[2];
uniform float metro_light_power;

in vec3 position_ws;
in vec3 normal_ws;
in vec3 camera_pos;
in vec2 uv_frag;
	

float joint_height = 0.04;
float joint_width = joint_height * 0.5;

float biseau_height = 0.1;
float biseau_width = 0.08;

float offset_vert = 0.15;
float offset_hor = 0.15;

uniform float roughness;
uniform float metallic;
float ambient_strength = 0.15;

vec4 LinearTosRGB( in vec4 value ) {
	return vec4( mix( pow( value.rgb, vec3( 0.41666 ) ) * 1.055 - vec3( 0.055 ), value.rgb * 12.92, vec3( lessThanEqual( value.rgb, vec3( 0.0031308 ) ) ) ), value.a );
}

float Fpo(float d, float l1, float l2) {
    // Difference of the two primitives, with a single atan.
    float angle = atan(d * (l2 - l1), d * d + l1 * l2);
    return (l2 / (d * d + l2 * l2) - l1 / (d * d + l1 * l1)) / d + angle / (d * d);
}

float Fwt(float d, float l) {
    return l * l / (d * (d * d + l * l));
}

// Analytic line integration from the reference project's ltcCylinder.frag.
float I_diffuse_line(vec3 p1, vec3 p2) {
    if (p1.z <= 0.0 && p2.z <= 0.0) return 0.0;
    if (dot(p2 - p1, p2 - p1) < 0.00000001) return 0.0;

    vec3 wt = normalize(p2 - p1);
    if (p1.z < 0.0) p1 = (p1 * p2.z - p2 * p1.z) / (p2.z - p1.z);
    if (p2.z < 0.0) p2 = (p2 * p1.z - p1 * p2.z) / (p1.z - p2.z);

    float l1 = dot(p1, wt);
    float l2 = dot(p2, wt);
    vec3 po = p1 - l1 * wt;
    float d = max(length(po), 0.0001);

    float I = Fpo(d, l1, l2) * po.z;
    I += (Fwt(d, l2) - Fwt(d, l1)) * wt.z;
    return max(I / PI, 0.0);
}

float I_ltc_line(vec3 p1, vec3 p2) {
    vec3 ortho = cross(p1, p2);
    if (dot(ortho, ortho) < 0.00000001) return 0.0;
    ortho = normalize(ortho);

    float w = 1.0 / max(length(width_matrix * ortho), 0.0001);
    return w * I_diffuse_line(Minv * p1, Minv * p2);
}

void main() {
    vec3 normal = normalize(normal_ws);

    float hauteur = 256.0;
    float largeur = 512.0;

    float ligne = floor(uv_frag.x * hauteur);

    vec2 tile;

    if (mod(ligne, 2.0) == 0.0)
        tile = vec2(uv_frag.x * hauteur, uv_frag.y * largeur);
    else
        tile = vec2(uv_frag.x * hauteur, uv_frag.y * largeur + 0.5);

    vec2 tile_pos = fract(tile);

    if ((joint_height / 2.0) < tile_pos.x && tile_pos.x < ((joint_height / 2.0) + biseau_height)) {
        float side_prop = (tile_pos.x - joint_height / 2.0) / biseau_height;

        if (joint_width / 2.0 < tile_pos.y && tile_pos.y < (joint_width / 2.0) + biseau_width - (biseau_width * (1.0 - side_prop)))
            normal = normalize(normal + vec3(0.0, 0.0, -offset_hor));
        else if ((1.0 - (joint_width / 2.0)) - biseau_width + (biseau_width * (1.0 - side_prop)) < tile_pos.y && tile_pos.y < 1.0 - joint_width / 2.0)
            normal = normalize(normal + vec3(0.0, 0.0, offset_hor));
        else
            normal = normalize(normal + vec3(0.0, -offset_vert, 0.0));
    }
    else if (1.0 - (joint_height / 2.0) - biseau_height < tile_pos.x && tile_pos.x < 1.0 - (joint_height / 2.0)) {
        float side_prop = (1.0 - joint_height / 2.0 - tile_pos.x) / biseau_height;

        if (joint_width / 2.0 < tile_pos.y && tile_pos.y < (joint_width / 2.0) + biseau_width - (biseau_width * (1.0 - side_prop)))
            normal = normalize(normal + vec3(0.0, 0.0, -offset_hor));
        else if ((1.0 - (joint_width / 2.0)) - biseau_width + (biseau_width * (1.0 - side_prop)) < tile_pos.y && tile_pos.y < 1.0 - joint_width / 2.0)
            normal = normalize(normal + vec3(0.0, 0.0, offset_hor));
        else
            normal = normalize(normal + vec3(0.0, -offset_vert, 0.0));
    } 
    else {
        if (joint_width / 2.0 < tile_pos.y && tile_pos.y < joint_width / 2.0 + biseau_width)
            normal = normalize(normal + vec3(0.0, 0.0, -offset_hor));
        else if (1.0 - (joint_width / 2.0) - biseau_width < tile_pos.y && tile_pos.y < 1.0 - joint_width / 2.0)
            normal = normalize(normal + vec3(0.0, 0.0, offset_hor));
    }

    bool u_joint = tile_pos.x < joint_height / 2.0 || 1 - joint_height / 2.0 < tile_pos.x;
    bool v_joint = tile_pos.y < joint_width / 2.0 || 1 - joint_width / 2.0 < tile_pos.y;

    vec3 joint_color = vec3(0.92, 0.9, 0.86);
    vec3 tile_color = vec3(0.92, 0.9, 0.86);
    vec3 the_color = u_joint || v_joint ? joint_color : tile_color;

    vec3 N = normal;
    vec3 wo = normalize(camera_pos - position_ws);
    vec3 albedo = the_color * color;
    vec3 final_color = albedo * ambient_strength;

    vec3 lightning = vec3(0.0);
    vec3 specular = vec3(0.0);
    const float metro_specular_strength = 0.1;

    float NdotV = clamp(dot(N, wo), 0.0, 1.0);
    vec2 uvltc = vec2(roughness, sqrt(1.0 - NdotV)) * LUT_SCALE + LUT_BIAS;
    vec4 t1 = texture(LTC1, uvltc);
    vec4 t2 = texture(LTC2, uvltc);

    Minv = mat3(vec3(t1.x, 0, t1.y), vec3(0, 1, 0), vec3(t1.z, 0, t1.w));
    width_matrix = inverse(transpose(Minv));

    vec3 T1 = wo - N * dot(wo, N);
    if (dot(T1, T1) < 0.00000001) {
        vec3 axis = abs(N.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        T1 = cross(axis, N);
    }
    T1 = normalize(T1);
    vec3 T2 = cross(N, T1);
    mat3 B = transpose(mat3(T1, T2, N));

    vec3 f0 = mix(vec3(0.04), albedo, metallic);
    vec3 F = f0 * t2.x + (vec3(1.0) - f0) * t2.y;
    vec3 kd = (vec3(1.0) - f0) * (1.0 - metallic);

    // TUBE LIGHTS
    for (int i = 0; i < min(nb_tubelights, LIGHTS); i++) {
        vec3 p1 = B * (tubelights[i].points[0] - position_ws);
        vec3 p2 = B * (tubelights[i].points[1] - position_ws);

        float diffuse = clamp(tubelights[i].radius * I_diffuse_line(p1, p2), 0.0, 1.0);
        float spec = NdotV > 0.0 ? clamp(tubelights[i].radius * I_ltc_line(p1, p2), 0.0, 1.0) : 0.0;

        final_color += (kd * albedo * diffuse + F * spec) * tubelights[i].color * tubelights[i].intensity;
    }

    // HEADLIGHTS
    for (int i = 0; i < 2; i++) {
        float light_power = 0.0;
        float fade_start = metro_lights[i].z;
        float fade_end = metro_lights[i].z + 1.2;

        if (position_ws.z > fade_end)
            light_power = metro_light_power;
        else if (position_ws.z > fade_start) {
            float fade = (position_ws.z - fade_start) / (fade_end - fade_start);
            light_power = mix(0.0, metro_light_power, fade);
        }

        vec3 dirlight = normalize(metro_lights[i] - position_ws);
        float diffuse = clamp(dot(N, dirlight), 0.0, 1.0);
        vec3 half_dir = normalize(dirlight + wo);
        float spec = pow(clamp(dot(N, half_dir), 0.0, 1.0), 64.0);

        float dist = length(metro_lights[i] - position_ws);
        float attenuation = light_power / (1.0 + 0.2 * dist + 0.08 * dist * dist);
        vec3 metro_light_color = vec3(1.0, 0.92, 0.75);

        lightning += diffuse * attenuation * metro_light_color;
        specular += metro_specular_strength * spec * attenuation * metro_light_color;
    }

    final_color += albedo * lightning + specular;

    final_color = final_color / (vec3(1.0) + final_color);
    //output_color = vec4(1.0, fract(uv_frag.y), 0.0, 1.0);
    output_color = LinearTosRGB(vec4(final_color, 1.0));
}
