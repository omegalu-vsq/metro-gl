#version 450

#define LIGHTS 20

uniform vec3 color;
uniform int podotactile_mode;

layout(location = 0) out vec4 output_color;

uniform int nb_light;
uniform vec3 lights[LIGHTS];
uniform vec3 metro_lights[2];
uniform float metro_light_power;
uniform vec3 light_color;
uniform mat4 model_view_matrix;

in vec3 position_view;
in vec3 position_world;
in vec3 normal_frag;
in vec3 object_normal_frag;
in vec2 uv_frag;
in vec3 object_pos_frag;

const float STUD_PITCH_Z = 0.063;
const float STUD_RADIUS = 0.022;

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));

    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    float value = 0.0;
    float amplitude = 0.5;
    for (int i = 0; i < 5; i++) {
        value += amplitude * noise(p);
        p *= 2.03;
        amplitude *= 0.5;
    }
    return value;
}

float podotactile_stud(vec3 opos) {
    vec2 stud = vec2(opos.z, opos.x) / STUD_PITCH_Z;
    vec2 local = fract(stud) - 0.5;
    local.y *= 0.75;
    float dist = length(local);
    return 1.0 - smoothstep(STUD_RADIUS / STUD_PITCH_Z, 0.0, dist);
}

float podotactile_height(vec3 opos) {
    return podotactile_stud(opos) * 0.055;
}

vec3 podotactile_normal(vec3 base_normal, vec3 opos) {
    float eps = 0.015;
    float h = podotactile_height(opos);
    float hx = podotactile_height(opos + vec3(eps, 0.0, 0.0)) - h;
    float hz = podotactile_height(opos + vec3(0.0, 0.0, eps)) - h;
    return normalize(base_normal + vec3(-hx / eps, 0.0, -hz / eps));
}

vec3 podotactile_albedo(vec3 opos, out float roughness) {
    float stud = podotactile_stud(opos);
    vec3 albedo = mix(vec3(0.97, 0.97, 0.96), vec3(0.84, 0.84, 0.83), stud * 0.35);
    roughness = mix(0.40, 0.26, stud);
    return albedo;
}

vec3 shade_surface(vec3 normal, vec3 albedo, float roughness) {
    vec3 view_dir = normalize(-position_view);
    float shininess = mix(180.0, 32.0, roughness);
    float spec_strength = mix(0.45, 0.08, roughness);
    vec3 lightning = albedo * 0.07;

    for (int i = 0; i < nb_light; i++) {
        vec3 light_view = (model_view_matrix * vec4(lights[i], 1.0)).xyz;
        vec3 dirlight = normalize(light_view - position_view);
        float diffuse = clamp(dot(normal, dirlight), 0.0, 1.0);
        vec3 half_dir = normalize(dirlight + view_dir);
        float spec = pow(clamp(dot(normal, half_dir), 0.0, 1.0), shininess);
        float dist = length(light_view - position_view);
        float attenuation = 1.0 / (1.0 + 0.04 * dist + 0.01 * dist * dist);
        vec3 radiance = light_color * attenuation;
        lightning += (albedo * diffuse + vec3(spec * spec_strength)) * radiance;
    }

    for (int i = 0; i < 2; i++) {
        float light_power = 0.0;
        float fade_start = metro_lights[i].z;
        float fade_end = metro_lights[i].z + 1.2;

        if (position_world.z > fade_end)
            light_power = metro_light_power;
        else if (position_world.z > fade_start) {
            float fade = (position_world.z - fade_start) / (fade_end - fade_start);
            light_power = mix(0.0, metro_light_power, fade);
        }

        vec3 light_view = (model_view_matrix * vec4(metro_lights[i], 1.0)).xyz;
        vec3 dirlight = normalize(light_view - position_view);
        float diffuse = clamp(dot(normal, dirlight), 0.0, 1.0);
        vec3 half_dir = normalize(dirlight + view_dir);
        float spec = pow(clamp(dot(normal, half_dir), 0.0, 1.0), shininess);

        float dist = length(light_view - position_view);
        float attenuation = light_power / (1.0 + 0.2 * dist + 0.08 * dist * dist);
        vec3 radiance = attenuation * vec3(1.0, 0.92, 0.75);

        lightning += (albedo * diffuse + vec3(spec * spec_strength)) * radiance;
    }

    float fresnel = pow(1.0 - clamp(dot(normal, view_dir), 0.0, 1.0), 4.0);
    lightning += fresnel * (1.0 - roughness) * 0.09;
    return lightning;
}

vec3 floor_albedo(vec3 opos, vec3 base_color, out float roughness) {
    vec2 uv = opos.xz * 0.35 + uv_frag * 4.0;

    float micro = fbm(uv * 18.0);
    float wear = fbm(uv * 4.5 + 17.3);
    float stains = fbm(uv * 1.2 + 4.7);
    float scratches = fbm(vec2(uv.x * 24.0 + wear * 2.0, uv.y * 3.0 + micro * 5.0));
    float chips = fbm(uv * 9.0 + vec2(stains, wear));

    roughness = clamp(
        0.12 + wear * 0.22 + stains * 0.18 + scratches * 0.20 + chips * 0.12,
        0.08,
        0.78
    );

    vec3 albedo = base_color;
    albedo *= 0.90 + 0.14 * wear;
    albedo *= mix(vec3(1.0), vec3(0.72, 0.70, 0.68), stains * 0.45);
    albedo *= mix(vec3(1.0), vec3(0.55, 0.53, 0.50), scratches * 0.35);
    albedo += vec3(0.025) * micro;
    return albedo;
}

void main() {
    vec3 base_normal = normalize(normal_frag);

    if (podotactile_mode != 0) {
        float roughness;
        vec3 albedo = podotactile_albedo(object_pos_frag, roughness);
        vec3 normal = normalize(mat3(model_view_matrix) * podotactile_normal(normalize(object_normal_frag), object_pos_frag));
        output_color = vec4(shade_surface(normal, albedo, roughness), 1.0);
        return;
    }

    float roughness;
    vec3 albedo = floor_albedo(object_pos_frag, color, roughness);
    output_color = vec4(shade_surface(base_normal, albedo, roughness), 1.0);
}
